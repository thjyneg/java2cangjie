#!/usr/bin/env python3
"""
cjpm build wrapper with automatic placeholder creation.

Usage: Same as cjpm build, but ensures _pkg.cj placeholders exist first.
    python cjpm_build.py <module_dir> [extra cjpm build args...]

This wraps `cjpm build` so that placeholder .cj files are automatically
created before compilation. cjpm requires at least one .cj file in each
directory to scan subdirectories — this script ensures that constraint
is always met.

Example:
    python scripts/cjpm_build.py /path/to/j2cjgenerated/module1
    python scripts/cjpm_build.py /path/to/module --verbose
"""

import subprocess
import sys
from pathlib import Path


def ensure_placeholders(src_dir: Path) -> int:
    """Recursively create _pkg.cj in dirs that have subdirs but no .cj files."""
    if not src_dir.is_dir():
        return 0

    try:
        entries = list(src_dir.iterdir())
    except PermissionError:
        return 0

    cj_files = [e for e in entries if e.is_file() and e.suffix == '.cj']
    subdirs = [
        e for e in entries
        if e.is_dir() and e.name not in ('target', '.cached', '_mock')
    ]

    count = 0
    if not cj_files and subdirs:
        placeholder = src_dir / '_pkg.cj'
        if not placeholder.exists():
            placeholder.write_text(
                '// placeholder for cjpm directory scanning\n',
                encoding='utf-8'
            )
            print(f'  [placeholder] {placeholder}')
            count += 1

    for sub in subdirs:
        count += ensure_placeholders(sub)

    return count


def main():
    if len(sys.argv) < 2:
        print('Usage: python cjpm_build.py <module_dir> [cjpm build args...]')
        sys.exit(1)

    module_dir = Path(sys.argv[1]).resolve()
    extra_args = sys.argv[2:]

    if not module_dir.is_dir():
        print(f'Error: {module_dir} is not a directory')
        sys.exit(1)

    src_dir = module_dir / 'src'

    # Step 1: ensure placeholders
    if src_dir.is_dir():
        print(f'[cjpm_build.py] Ensuring placeholders in {src_dir} ...')
        n = ensure_placeholders(src_dir)
        if n > 0:
            print(f'[cjpm_build.py] Created {n} placeholder file(s)')

    # Step 2: run cjpm build
    cmd = ['cjpm', 'build'] + extra_args
    print(f'[cjpm_build.py] Running: {" ".join(cmd)} (cwd={module_dir})')
    result = subprocess.run(cmd, cwd=str(module_dir))

    sys.exit(result.returncode)


if __name__ == '__main__':
    main()
